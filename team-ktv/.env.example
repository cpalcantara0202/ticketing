# =========================================================================
# Backend environment template
# Copy this file to ".env" and fill in the real values.
#   cp .env.example .env
# NEVER commit the real ".env" (it is gitignored).
# =========================================================================

# --- Core ---
development_mode=true
backend_port=4001

# MongoDB connection string (Atlas or local).
# Example (Atlas SRV): mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
mongo_db_connection_string="<YOUR_MONGODB_CONNECTION_STRING>"

# --- URLs ---
base_url="http://localhost:4000"
frontend_url="http://localhost:9000"
sql_clone=0

# --- Telegram (notifications) ---
telegram_channel="<YOUR_TELEGRAM_CHANNEL_ID>"
telegram_token="<YOUR_TELEGRAM_BOT_TOKEN>"

# --- Facebook (optional integrations) ---
facebook_app_id="<YOUR_FACEBOOK_APP_ID>"
facebook_secret="<YOUR_FACEBOOK_APP_SECRET>"

# --- Email (SMTP) ---
mail_host="smtp.gmail.com"
mail_user="<YOUR_SMTP_USER>"
mail_pass="<YOUR_SMTP_APP_PASSWORD>"
mail_from="<YOUR_FROM_ADDRESS>"
mail_name="gmail.com"
mail_port=587
mail_secure=0
